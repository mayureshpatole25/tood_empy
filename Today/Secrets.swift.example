import Foundation

/// Copy this file to Secrets.swift and fill in your own Google OAuth
/// client credentials (console.cloud.google.com -> APIs & Services ->
/// Credentials -> create an OAuth client ID of type "Desktop app").
/// Secrets.swift is gitignored so real credentials never get committed.
enum GoogleOAuthSecrets {
    static let clientID = "YOUR_CLIENT_ID.apps.googleusercontent.com"
    static let clientSecret = "YOUR_CLIENT_SECRET"
}
